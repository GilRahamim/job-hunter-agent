# Copy to .env and fill in the key for the provider set in config.yaml
# (used for CV extraction and job scoring). "Prepare with Claude" in the dashboard does not use it:
# it runs Claude Code on your Claude subscription and removes this key from that window.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional: extra config files merged over config.yaml, e.g. a local vLLM server for scoring and the
# smart agent (docs/LOCAL_LLM_AND_DOCKER.md). Delete the line to go back to config.yaml alone.
# JOBHUNTER_CONFIG=config.vllm.yaml

# Optional: Google Jobs via SerpAPI (sources.serpapi_google_jobs.enabled: true)
# SERPAPI_API_KEY=

# Optional: LangSmith tracing of the LangGraph pipeline
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=job-hunter-agent
