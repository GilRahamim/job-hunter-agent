     "jobDescription": {
      "title": "Job Description",
      "text": "<p>Responsibilities<br /><br />- Build automation tools to provision environments and applications to support our development, staging, and production environments. The focus will be on improving deployments using docker and related technologies.<br />- Work across functional (development/testing, deployment, systems/infrastructure) and project teams to ensure continuous delivery<br />- Work to continuously improve speed, efficiency and scalability of software delivery<br />- Automate wherever feasible<br /></p>"
     },
     "qualifications": {
      "title": "Qualifications",
      "text": "<p>Experience and passion working in a DevOps culture</p><p><span>Excellent knowledge and extensive experience of Linux, e.g. Debian/Ubuntu</span><br /></p><p>Experience with SQL- (Postgres) databases</p><p>Experience with Jenkins or other CI tools.</p><p>Experience with virtualization stacks like qemu and kvm.</p><p>Perfect understanding of webserver technologies (Apache, nginx) and HTTP</p><p>Skills with automation, using Bash, Python and tools like Terraform, Ansible</p><p></p><p>Worked with distributed version control in Git.</p><p><span>Experience in monitoring tools such as Prometheus, Grafana, ELK.</span></p><p></p><p>Experience in tools such as Mesos, Docker<span> are considered a plus.</span></p><p></p><p></p><p></p>"
     },
